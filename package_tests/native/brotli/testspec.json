    },
    {
      "source": "main_quality.c",
      "language": "c",
      "link_with": [
        "brotlienc",
        "brotlidec",
        "brotlicommon"
      ],
      "runtime_timeout_s": 10.0
    },
    {
      "source": "main_decoder_error.c",
      "language": "c",
      "link_with": [
        "brotlienc",
        "brotlidec",
        "brotlicommon"
