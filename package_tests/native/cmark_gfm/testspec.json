  "expected_artifacts": [
    "bin/cmark-gfm",
    "include/cmark-gfm.h",
    "include/cmark-gfm-core-extensions.h",
    "lib64/libcmark-gfm.so.0.29.0.gfm.13",
    "lib64/libcmark-gfm-extensions.so.0.29.0.gfm.13",
    "lib64/pkgconfig/libcmark-gfm.pc"
  ],
  "expected_artifact_globs": [
    "lib64/libcmark-gfm.so.0.29.0.gfm.13",
    "lib64/libcmark-gfm-extensions.so.0.29.0.gfm.13"
  ],
  "static_archives_must_be_pic": false,
  "smoke_run": {
    "command": "bin/cmark-gfm",
    "args": [
      "--version"
