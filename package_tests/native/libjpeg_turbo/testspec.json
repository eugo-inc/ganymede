        "jpeg"
      ],
      "runtime_timeout_s": 10.0
    },
    {
      "source": "main_yuv.c",
      "language": "c",
      "link_with": [
        "turbojpeg"
      ],
      "runtime_timeout_s": 10.0
    },
    {
      "source": "main_transform.c",
      "language": "c",
      "link_with": [
        "turbojpeg"
      ],
      "runtime_timeout_s": 10.0
    }
  ]
