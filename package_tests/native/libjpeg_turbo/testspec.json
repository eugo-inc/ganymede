  "expected_artifacts": [
    "bin/cjpeg",
    "bin/djpeg",
    "bin/jpegtran",
    "lib64/libjpeg.so",
    "lib64/libturbojpeg.so.0",
    "include/jpeglib.h",
    "include/turbojpeg.h"
  ],
