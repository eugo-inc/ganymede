{
  "name": "libwebp",
  "kind": "shared-and-static-libs-with-cli",
  "expected_artifacts": [
    "bin/cwebp",
    "bin/dwebp",
    "lib64/libwebp.so",
    "lib64/libwebpdemux.so",
    "lib64/libsharpyuv.so",
    "include/webp/decode.h",
    "include/webp/encode.h",
    "lib64/pkgconfig/libwebp.pc"
  ],
  "expected_artifact_globs": [],
