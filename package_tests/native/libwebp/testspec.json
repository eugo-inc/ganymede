      ]
    },
    {
      "source": "main_sharpyuv.c",
      "language": "c",
      "link_with": [
        "sharpyuv"
      ],
      "extra_cflags": [
        "-I{prefix}/include/webp"
      ]
    },
    {
      "source": "main_advanced_encode.c",
      "language": "c",
      "link_with": [
        "webp"
      ]
    },
    {
      "source": "main_incremental_decode.c",
      "language": "c",
      "link_with": [
        "webp"
      ]
    }
  ]
