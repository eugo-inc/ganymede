{
  "name": "libxslt",
  "kind": "shared-libs-with-cli",
  "expected_artifacts": [
    "bin/xsltproc",
    "lib64/libxslt.so",
    "lib64/libexslt.so",
    "include/libxslt/xslt.h",
    "include/libexslt/exslt.h",
    "lib64/pkgconfig/libxslt.pc"
  ],
  "expected_artifact_globs": [],
  "static_archives_must_be_pic": false,
  "smoke_run": {
    "command": "bin/xsltproc",
    "args": [
      "--version"
    ],
    "expect_stdout_contains": null
  },
  "test_programs": [
