---
// SPDX-License-Identifier: BSD-3-Clause
// Copyright (c) 2026, Eugo, Inc.
// Starlight's page title, followed by the page's links: its source on GitHub and, on a
// notebook's page, the notebook to download.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Icon } from '@astrojs/starlight/components';

const { github, download } = Astro.locals.starlightRoute.entry.data;
---

<Default />
{
  (github || download) && (
    <div class="gn-actions not-content">
      {github && (
        <a href={github}>
          <Icon name="github" size="1.1em" />
          View on GitHub
        </a>
      )}
      {download && (
        <a href={download} download>
          <Icon name="download" size="1.1em" />
          Download notebook (.ipynb)
        </a>
      )}
    </div>
  )
}
