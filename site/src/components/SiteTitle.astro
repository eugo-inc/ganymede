---
// SPDX-License-Identifier: BSD-3-Clause
// Copyright (c) 2026, Eugo, Inc.
// Starlight's site title in the header (the mark and the name, a link to the home page), followed
// by "by" and the maker's logo, a link to the maker's home page: indigo on the light theme, white on
// the dark one.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import indigo from '../assets/eugo-logo-indigo.png';
import white from '../assets/eugo-logo-white.png';
---

<Default />
<a class="pb-by" href="https://eugo.io/"
	><span>by</span><img
		class="pb-logo-light"
		src={indigo.src}
		width={indigo.width}
		height={indigo.height}
		alt="Eugo"
	/><img class="pb-logo-dark" src={white.src} width={white.width} height={white.height} alt="Eugo" /></a
>

<style>
	.pb-by {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 0.4em;
		margin-inline-start: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-decoration: none;
		white-space: nowrap;
	}
	.pb-by:hover {
		color: var(--sl-color-white);
	}
	.pb-by img {
		display: block;
		height: 1.125rem;
		width: auto;
	}
	:global(:root[data-theme='light']) .pb-logo-dark,
	:global(:root:not([data-theme='light'])) .pb-logo-light {
		display: none;
	}
	/* On a narrow screen the header keeps its room for the name, the search and the menu. */
	@media (max-width: 36rem) {
		.pb-by {
			display: none;
		}
	}
</style>
